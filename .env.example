# Copy to .env.local. Defaults match docker-compose.yml.

DATABASE_URL=postgres://tripfolio:tripfolio@localhost:5432/tripfolio

# S3-compatible storage (RustFS locally; AWS S3 / Cloudflare R2 / MinIO in production)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=tripfolio-photos
S3_ACCESS_KEY_ID=tripfolio
S3_SECRET_ACCESS_KEY=tripfolio-secret
S3_FORCE_PATH_STYLE=true

# Public origin of the app (used for OAuth redirects and email links)
APP_URL=http://localhost:3000

# Optional: Google sign-in. Create an OAuth client at https://console.cloud.google.com/apis/credentials
# with redirect URI  {APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
