# Copy to .env.local. Defaults match docker-compose.yml.

DATABASE_URL=postgres://tripfolio:tripfolio@localhost:5432/tripfolio

# S3-compatible storage (RustFS locally; AWS S3 / Cloudflare R2 / MinIO in production)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=tripfolio-photos
S3_ACCESS_KEY_ID=tripfolio
S3_SECRET_ACCESS_KEY=tripfolio-secret
S3_FORCE_PATH_STYLE=true
# Optional: address browsers use for signed photo links, if different from S3_ENDPOINT
# (e.g. the server reaches storage on an internal hostname).
S3_PUBLIC_ENDPOINT=

# Public origin of the app (used for OAuth redirects and email links)
APP_URL=http://localhost:3000

# Optional: Google sign-in. Create an OAuth client at https://console.cloud.google.com/apis/credentials
# with redirect URI  {APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email (optional). Without a key, emails are printed to the server console.
# RESEND_API_KEY=re_...
# MAIL_FROM="Tripfolio <hello@yourdomain.com>"

# Optional: Google Analytics 4. The live site's ID is built in and only runs on www.trip-folio.com,
# for visitors who accept all cookies. Set this to test GA anywhere else, with a test property.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
